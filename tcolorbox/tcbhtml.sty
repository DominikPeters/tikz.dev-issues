% tcbhtml.sty -- instrumentation for the HTML version of the tcolorbox manual.
%
% The generic capture machinery is in tikzdev-capture.sty (shared/texhtml);
% this file only hooks the examples of tcolorbox's documentation library into
% it: the compiled lower part of a dispExample box is captured.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tcbhtml}[2026/10/17 HTML extraction for the tcolorbox manual]
\RequirePackage{tikzdev-capture}

\def\enddispExample{%
  \endtcbwritetemp\endgroup%
  \begin{tcolorbox}%
  \tcb@doc@usetemplisting%
  \tcblower%
  \HTMLexamplebegin\tcbusetemp\HTMLexampleend%
  \end{tcolorbox}%
}

\endinput
